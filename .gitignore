# Data — never commit real data. Real data lives in the team's Google Drive.
# (tests/fixtures/ is a separate top-level path and is tracked normally.)
# data/00_raw/ stays untracked via this blanket rule (no exception below).
data/*

# Exception (Phase 7, decided 2026-08-24): the built warehouse + persisted
# models are derived build artifacts, not raw source data. Streamlit
# Community Cloud deploys straight from GitHub with no persistent mounted
# storage, so the dashboard needs these committed to run.
!data/30_warehouse/
data/30_warehouse/*
!data/30_warehouse/warehouse.duckdb

!data/50_models/
data/50_models/*
!data/50_models/*.joblib
!data/50_models/*.pt

# Warehouse / DB files (elsewhere in the repo — not the exception above)
*.duckdb.wal
*.sqlite
*.sqlite3

# Logs
logs/
*.jsonl

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.eggs/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# uv
.uv/

# Jupyter
.ipynb_checkpoints/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.tox/

# Environment / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Build artifacts
build/
dist/
*.egg-info/
